      <aliases enabled='yes' />
      <column caption='Blank' datatype='string' name='[Calculation_0127575371169799]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Total Registrations' datatype='integer' name='[Calculation_1925000062349313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Registration_Number])' />
      </column>
      <column caption='Distinct States' datatype='integer' name='[Calculation_1925000062525442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([State])' />
      </column>
      <column caption='Average Vehicle Age' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1925000062763011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Vehicle_Age_Years])' />
      </column>
      <column caption='EV + Hybrid Adoption Rate' datatype='real' default-format='p0.0%' name='[Calculation_1925000242368516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fuel_Type]=&quot;EV&quot; OR [Fuel_Type]=&quot;Hybrid&quot; THEN 1 ELSE 0 END)/COUNT([Registration_Number])' />
      </column>
      <column caption='Registrations 2018' datatype='integer' name='[Calculation_1925000242757637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Registration_Year]=2018 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Registrations 2024' datatype='integer' name='[Calculation_1925000243290118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Registration_Year]=2024 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='CAGR 2018-2024' datatype='real' default-format='p0.0%' name='[Calculation_1925000243404807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1925000243290118]/[Calculation_1925000242757637])^(1.0/6)-1' />
      </column>
      <column caption='Registrations 2019' datatype='integer' name='[Calculation_1925000245313544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Registration_Year]=2019 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Registrations 2020' datatype='integer' name='[Calculation_1925000245489673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Registration_Year]=2020 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Registrations 2021' datatype='integer' name='[Calculation_1925000245665802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Registration_Year]=2021 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Registrations 2022' datatype='integer' name='[Calculation_1925000245813259]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Registration_Year]=2022 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Registrations 2023' datatype='integer' name='[Calculation_1925000245940236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Registration_Year]=2023 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='BS6 Compliance rate' datatype='real' default-format='p0.0%' name='[Calculation_1925000246075405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Emission_Norm]=&quot;BS6&quot; THEN 1 ELSE 0 END)/COUNT([Registration_Number])' />
      </column>
      <column caption='YoY growth (previous year 23-24)' datatype='real' default-format='p0.0%' name='[Calculation_1925000248565774]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1925000243290118]-[Calculation_1925000245940236])/[Calculation_1925000245940236]' />
      </column>
      <column caption='2W-Share' datatype='real' default-format='p0.0%' name='[Calculation_1925000271249423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Vehicle_Category]=&quot;2W&quot; THEN 1 ELSE 0 END)/[Calculation_1925000062349313]' />
      </column>
      <column caption='4W-Share' datatype='real' default-format='p0.0%' name='[Calculation_1925000271544336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Vehicle_Category]=&quot;4W&quot; THEN 1 ELSE 0 END)/[Calculation_1925000062349313]' />
      </column>
